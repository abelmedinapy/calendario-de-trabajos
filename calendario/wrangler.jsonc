{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendario",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendario",
      "database_id": "5513d525-e932-4109-afb9-f5db3175c0b8"
    }
  ]
}
